# Required: supply your own unique random secret (at least 32 bytes); no public default.
JWT_SECRET=
DATABASE_URL=postgresql+psycopg://aiwardrobe@localhost:5432/aiwardrobe
# Raw password; Settings encodes it into DATABASE_URL safely (including @:/?#%).
POSTGRES_PASSWORD=
FRONTEND_ORIGIN=http://localhost:5174

STORAGE_DRIVER=s3
S3_ENDPOINT_URL=http://localhost:9100
S3_BUCKET=aiwardrobe
WEDDING_S3_BUCKET=aiwardrobe-wedding-private
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PUBLIC_STORAGE_BASE_URL=http://localhost:9100/aiwardrobe

AI_DEMO_MODE=false
GARMENT_AI_PROVIDER=qwen
AI_BASE_URL=http://127.0.0.1:1234
AI_API_KEY=
AI_MODEL=qwen3-vl-8b-instruct

# Wedding MV stays disabled by default. "demo" uses local plumbing assets with a
# visible watermark and no AI motion. Set live explicitly and configure each adapter
# and its credentials/prices to use paid calls. Keys must match the selected region.
WEDDING_MEDIA_MODE=disabled
WEDDING_ACCOUNT_BUDGET_LIMIT_FEN=15000
WEDDING_WORKER_STALE_SECONDS=1800
WEDDING_STORY_PROVIDER=disabled
WEDDING_STORY_API_KEY=
WEDDING_STORY_MODEL=doubao-seed-2-0-pro-260215
WEDDING_FRAME_PROVIDER=disabled
WEDDING_FRAME_API_KEY=
WEDDING_FRAME_MODEL=doubao-seedream-4-5-251128
WEDDING_CHARACTER_VIDEO_PROVIDER=disabled
WEDDING_CHARACTER_VIDEO_API_KEY=
WEDDING_CHARACTER_VIDEO_MODEL=wan2.7-r2v-2026-06-12
WEDDING_SCENE_VIDEO_PROVIDER=disabled
WEDDING_SCENE_VIDEO_API_KEY=
WEDDING_SCENE_VIDEO_MODEL=wan2.6-i2v-flash
# Supported provider selectors: ark, seedream, wan_r2v, wan_i2v_flash.
WEDDING_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Workspace domain may replace this legacy Beijing domain; match key/model region.
WEDDING_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
WEDDING_CONNECT_TIMEOUT_SECONDS=10
WEDDING_READ_TIMEOUT_SECONDS=60
WEDDING_POLL_INTERVAL_SECONDS=3
WEDDING_TOTAL_TIMEOUT_SECONDS=600
WEDDING_IO_HEARTBEAT_SECONDS=0.25
WEDDING_MAX_JSON_BYTES=32000000
WEDDING_MAX_REQUEST_BYTES=60000000
WEDDING_MAX_IMAGE_BYTES=20000000
WEDDING_MAX_VIDEO_BYTES=100000000
# Allow only verified official CDN domains; every resolved IP must be public.
WEDDING_DOWNLOAD_ALLOWED_DOMAINS=oss-cn-beijing.aliyuncs.com,oss-cn-shanghai.aliyuncs.com,oss-accelerate.aliyuncs.com,volces.com
# Estimates use ceiling to whole fen. Provider usage is not an authoritative bill.
WEDDING_PRICE_VERSION=cn-baseline-2026-10-01
# Token prices have no default. Set positive explicit fen per million-token rates
# from the account's current model price before enabling the story adapter.
# WEDDING_STORY_INPUT_FEN_PER_MILLION_TOKENS=
# WEDDING_STORY_OUTPUT_FEN_PER_MILLION_TOKENS=
WEDDING_STORY_MAX_COST_FEN=100
WEDDING_STORY_MAX_TOKENS=8192
WEDDING_FRAME_FEN_PER_IMAGE=25
WEDDING_R2V_FEN_PER_SECOND=100
WEDDING_I2V_FLASH_FEN_PER_SECOND=25
WEDDING_FFMPEG_PATH=
# JSON catalog with explicit embedded delivery and wedding playback grants. Empty disables live music.
WEDDING_MUSIC_CATALOG_FILE=
# Compose mounts this host directory read-only at /wedding-music. Catalog and
# track paths must be container paths, e.g. /wedding-music/catalog.json.
# WEDDING_MUSIC_DIRECTORY=./runtime/wedding-music
# For legacy naive PG columns, set the original writer timezone if different
# from the migration session. Already-aware columns ignore this override.
# WEDDING_LEGACY_TIMESTAMP_TIMEZONE=Asia/Shanghai
# Legacy settings alone do not prove delivery rights and cannot authorize live renders.
WEDDING_MUSIC_FILE=
WEDDING_MUSIC_LICENSE_ID=

# Workflow provider for automatic multi-item extraction.
# Use "runninghub" for hosted workflows; "comfyui" remains available for local testing.
WORKFLOW_PROVIDER=runninghub
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_CLIENT_ID=aiwardrobe-backend
COMFYUI_POLL_INTERVAL_SECONDS=1
COMFYUI_POLL_TIMEOUT_SECONDS=600
COMFYUI_GARMENT_WORKFLOW_FILE=workflows/garment_recognition.json
COMFYUI_LOAD_IMAGE_NODE_ID=78

# RunningHub workflows for garment recognition / future AI try-on.
# Fill RUNNINGHUB_API_KEY in .env before using automatic recognition.
RUNNINGHUB_BASE_URL=https://www.runninghub.cn
RUNNINGHUB_API_KEY=
RUNNINGHUB_POLL_INTERVAL_SECONDS=2
RUNNINGHUB_POLL_TIMEOUT_SECONDS=600
RUNNINGHUB_GARMENT_WORKFLOW_FILE=workflows/garment_recognition.json
RUNNINGHUB_TRYON_WORKFLOW_FILE=workflows/ai_tryon.json

# AI outfit recommendation provider. Keep image/VL recognition on AI_* if needed,
# while recommendation can use DeepSeek's OpenAI-compatible chat completions API.
OUTFIT_AI_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Optional overrides when using another OpenAI-compatible provider for outfits:
OUTFIT_AI_BASE_URL=
OUTFIT_AI_API_KEY=
OUTFIT_AI_MODEL=

# Shopping recommendations use Taobao/Tmall search. Keep demo mode enabled until
# the application-level Taobao Open Platform / Taobao affiliate credentials are configured.
SHOPPING_RECOMMENDATION_DEMO_MODE=true
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ADZONE_ID=
TAOBAO_API_BASE_URL=https://eco.taobao.com/router/rest

WEATHER_PROVIDER=open_meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com
SOLAR_TERMS_API_URL=https://www.hko.gov.hk/en/gts/astronomy/data/files/24SolarTerms_{year}.xml

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@aiwardrobe.local

# Wedding render/retention. No music rights are granted by these settings.
# WEDDING_FFPROBE_PATH=ffprobe
WEDDING_RENDER_TIMEOUT_SECONDS=900
WEDDING_RENDER_THREADS=2
WEDDING_RENDER_LEASE_SECONDS=120
WEDDING_RENDER_MAX_ATTEMPTS=3
WEDDING_PREVIEW_BANDWIDTH_BYTES=21474836480
# Local Windows default is Microsoft YaHei; Docker default is Noto Sans CJK SC.
# WEDDING_SUBTITLE_FONT=Microsoft YaHei
WEDDING_S3_CONNECT_TIMEOUT_SECONDS=5
WEDDING_S3_READ_TIMEOUT_SECONDS=30
