JWT_SECRET=replace-with-a-random-32-byte-minimum-secret
DATABASE_URL=postgresql+psycopg://aiwardrobe:aiwardrobe@localhost:5432/aiwardrobe
FRONTEND_ORIGIN=http://localhost:5173

STORAGE_DRIVER=s3
S3_ENDPOINT_URL=http://localhost:9100
S3_BUCKET=aiwardrobe
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
PUBLIC_STORAGE_BASE_URL=http://localhost:9100/aiwardrobe

AI_DEMO_MODE=false
GARMENT_AI_PROVIDER=qwen
AI_BASE_URL=http://127.0.0.1:1234
AI_API_KEY=
AI_MODEL=qwen3-vl-8b-instruct

# Workflow provider for automatic multi-item extraction.
# Use "comfyui" locally with ComfyUI listening on 127.0.0.1:8188.
WORKFLOW_PROVIDER=comfyui
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_CLIENT_ID=aiwardrobe-backend
COMFYUI_POLL_INTERVAL_SECONDS=1
COMFYUI_POLL_TIMEOUT_SECONDS=180
COMFYUI_GARMENT_WORKFLOW_FILE=workflows/garment_recognition.json
COMFYUI_LOAD_IMAGE_NODE_ID=78

# Optional: use RunningHub workflows for garment recognition / future AI try-on.
# Set GARMENT_AI_PROVIDER=runninghub after filling API key and workflow ids.
RUNNINGHUB_BASE_URL=https://www.runninghub.cn
RUNNINGHUB_API_KEY=
RUNNINGHUB_POLL_INTERVAL_SECONDS=2
RUNNINGHUB_POLL_TIMEOUT_SECONDS=120
RUNNINGHUB_GARMENT_WORKFLOW_FILE=workflows/garment_recognition.json
RUNNINGHUB_TRYON_WORKFLOW_FILE=workflows/ai_tryon.json

# AI outfit recommendation provider. Keep image/VL recognition on AI_* if needed,
# while recommendation can use DeepSeek's OpenAI-compatible chat completions API.
OUTFIT_AI_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Optional overrides when using another OpenAI-compatible provider for outfits:
OUTFIT_AI_BASE_URL=
OUTFIT_AI_API_KEY=
OUTFIT_AI_MODEL=

WEATHER_PROVIDER=open_meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@aiwardrobe.local
